# Usamos a versão slim do Node.js para manter a imagem base leve
FROM node:22-slim

# 1. Instalar dependências do sistema operacional
# Inclui Python, Java (para Audiveris), Tesseract (OCR), MuseScore (renderização) e bibliotecas gráficas
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    openjdk-17-jre-headless \
    tesseract-ocr tesseract-ocr-por tesseract-ocr-eng \
    musescore3 xvfb xauth \
    wget fontconfig libfreetype6 liblept5 libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# 2. Baixar e instalar o Audiveris oficial (versão 5.11.0 para Linux x86_64)
# O pacote .deb oficial instala a estrutura diretamente em /opt/audiveris
RUN wget https://github.com/Audiveris/audiveris/releases/download/5.11.0/Audiveris-5.11.0-ubuntu22.04-x86_64.deb -O /tmp/audiveris.deb \
    && dpkg-deb -x /tmp/audiveris.deb / \
    && chmod +x /opt/audiveris/bin/Audiveris \
    && rm /tmp/audiveris.deb

# 3. Configurar ambiente Python e music21
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install music21

# 4. Configurar variáveis de ambiente
ENV JAVA_OPTS="-Xmx2G -Djava.awt.headless=true"
ENV QT_QPA_PLATFORM=offscreen

# 5. Configurar a aplicação Node.js
WORKDIR /app
COPY package*.json ./
RUN npm install --legacy-peer-deps
COPY . .
RUN npm run build

# Ativa o modo de produção para servir o build compilado (elimina erros de HMR/WebSocket)
ENV NODE_ENV=production

EXPOSE 3000
CMD ["npm", "start"]